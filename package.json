{
  "name": "ai_uploader",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:api": "wrangler dev",
    "build:css": "npx @tailwindcss/cli -i web/src/app.css -o web/public/app.css --minify --content ./src/**/*.{ts,tsx,js,jsx},./web/**/*.{html,ts,tsx,js,jsx}",
    "build:web": "npm run build:css && vite build",
    "build": "npm run build:web",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev:web": "vite dev --root web",
    "preview:web": "vite preview --host --port 5173 --outDir dist --strictPort"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozekimasaki/ai_uploader.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ozekimasaki/ai_uploader/issues"
  },
  "homepage": "https://github.com/ozekimasaki/ai_uploader#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20250921.0",
    "@tailwindcss/cli": "^4.1.13",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.38.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*",
    "@rollup/wasm-node": "*"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0"
  }
}
